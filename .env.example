AWS_REGION=us-east-1
MODEL_ID=anthropic.claude-haiku-4-5-20251001-v1:0

# aws (default) or floci (local emulator with dummy credentials).
AWS_MODE=aws
# Set for Floci; leave empty for real AWS.
AWS_ENDPOINT_URL=
# Product data comes from live Amazon via Selenium, independently of Floci.

REVIEW_WINDOW_DAYS=90
MAX_REVIEWS_PER_ASIN=33
MAX_PRODUCTS=5

METRICS_NAMESPACE=ProductIntelligence
LOG_GROUP_NAME=/product-intelligence/app
SNS_TOPIC_ARN=

AGENT_ERROR_THRESHOLD=5
INPUT_TOKEN_ALARM_THRESHOLD=50000
DAILY_COST_BUDGET_USD=5.0
