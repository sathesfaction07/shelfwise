AWS_MODE=floci
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_EC2_METADATA_DISABLED=true
# Floci maps this Bedrock model alias to Ollama's configured default model.
# Keep a known model alias for the application's illustrative cost estimates.
MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
MODEL_ID_TOOLS=amazon.nova-micro-v1:0
REQUIRE_LLM_SUCCESS=true
LOCAL_LLM_TIMEOUT_SECONDS=75
LOCAL_REVIEW_EXCERPT_CHARS=300
LOCAL_REVIEW_SAMPLE_PER_SENTIMENT=3
DAILY_COST_BUDGET_USD=5.0
